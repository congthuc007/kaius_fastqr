# ==============================================================================
# ⚙️ BIẾN MÔI TRƯỜNG DỰ ÁN KAIUS FASTQR (.env.example)
# Sao chép tệp này thành .env hoặc .env.local và thay đổi các giá trị theo nhu cầu
# ==============================================================================

# 1. Cấu hình GitHub (Khi đổi tài khoản hoặc repo chỉ cần đổi 2 biến này)
NEXT_PUBLIC_GITHUB_USERNAME=congthuc007
NEXT_PUBLIC_GITHUB_REPO=kaius_fastqr

# 2. Cấu hình Tác giả & Thương hiệu
NEXT_PUBLIC_AUTHOR_NAME=Nguyễn Công Thức (Kaius)
NEXT_PUBLIC_AUTHOR_BRAND=Kaius
NEXT_PUBLIC_AUTHOR_EMAIL=thuctk04@gmail.com

# 3. Cấu hình Domain & Website
NEXT_PUBLIC_SITE_DOMAIN=fastqr.kaius.id.vn
NEXT_PUBLIC_SITE_URL=https://fastqr.kaius.id.vn
NEXT_PUBLIC_SITE_NAME=Kaius FastQR
NEXT_PUBLIC_SITE_TAGLINE=Trình Tạo & Quét Mã QR Code Chuyên Nghiệp Miễn Phí
NEXT_PUBLIC_SITE_DESCRIPTION=Trình tạo và quét mã QR Code chuyên nghiệp miễn phí trực tuyến. Hỗ trợ tạo mã QR URL, vCard danh bạ, WiFi, GPS vị trí khóa (Geo-lock), SMS, Email, Sự kiện, Facebook, Multi-Link. Tùy chỉnh màu sắc, chèn logo cá nhân, kiểm tra tương phản chuẩn WCAG, tải xuống ảnh chất lượng cao không bao giờ hết hạn.
